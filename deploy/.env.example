# ===== 服务器端 secret 文件（数据库凭据 + datahub 读 token）=====
# 原则：业务配置（飞书/Tushare 等）一律走设置页 → app_config 表；
# env 层只保留「密钥」——目前两处：① 数据库凭据；② datahub 读 token。
# 部署时把本文件复制为 .env 并填入强密码，然后：
#   chmod 600 .env
# .env 已被 .gitignore 排除，永不入库。

DB_HOST=postgres
DB_PORT=5432
DB_USER=quant
# 强随机密码：openssl rand -hex 24
DB_PASSWORD=change_me_strong_password
DB_NAME=quant_system

# ===== datahub 读切换（Phase 3）=====
# steady 按需调 datahub HTTP API 取原始数据（单一真源）。**默认全空 = 读本地库，零行为变更**。
# 翻闸：把 DATAHUB_READ_DATASETS 置为要切的数据集 id（多个逗号分隔）；**回退**：清空该值重启。
# DATAHUB_TOKEN 须与 datahub 服务侧 DATAHUB_TOKEN **逐字一致**（否则 401，fail-closed）。
# DATAHUB_BASE_URL 默认 http://datahub:8100（datahub API 加入本栈 docker 网络后按服务名可达）。
DATAHUB_READ_DATASETS=
DATAHUB_BASE_URL=http://datahub:8100
DATAHUB_TOKEN=
# 可选：读失败时回退本地（默认 0 = 失败即抛，不静默）。
DATAHUB_FALLBACK_LOCAL=0
